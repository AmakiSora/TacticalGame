# Deploy credentials - copy to .env.deploy and fill in
# WARNING: Do not commit .env.deploy to git!

DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22

# 建议:非 root 部署账户(需在 docker 组),root 仅为默认兼容值
DEPLOY_USER=root

# 认证二选一:SSH 密钥优先,密码作为 fallback(也兼作加密密钥的 passphrase)
# DEPLOY_KEY_PATH=C:/Users/you/.ssh/id_ed25519
DEPLOY_PASSWORD=your-password-here

DEPLOY_REMOTE_BASE=/srv/tactical-game

# 必填:管理端点控制令牌(删除对局/强制裁决/管理员改名),每次部署固定不轮换
# 生成: openssl rand -hex 32
CONTROL_TOKEN=your-token-here

# 可选:写入远端 .env 的日志级别(默认 info)
# LOG_LEVEL=info

# 可选:置 1 时删除远端 REMOTE_BASE 下已不在本地的残留文件(保护 .env 与 backups/)
# DEPLOY_PRUNE=1
