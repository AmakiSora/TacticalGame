{
  "name": "tactical-game",
  "version": "3.5.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build": "tsc",
    "build:frontend": "vite build",
    "build:all": "npm run build && npm run build:frontend",
    "preview": "vite preview",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats": "node script/generateStats.mjs",
    "fun-stats": "node script/generateFunStats.mjs",
    "rl-leaderboard": "node script/generateRlLeaderboard.mjs",
    "rl-stats": "node script/generateRlStats.mjs",
    "stats-all": "node script/generateStats.mjs && node script/generateFunStats.mjs && node script/generateRlLeaderboard.mjs && node script/generateRlStats.mjs",
    "version": "node script/bump-version.mjs",
    "sync-version": "node script/bump-version.mjs",
    "check-version": "node script/bump-version.mjs --check",
    "test:rl": "rl/.venv/Scripts/python.exe -m pytest tests/rl -q"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.5",
    "terser": "^5.51.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
