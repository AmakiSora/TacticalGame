{
  "name": "tactical-game",
  "version": "3.4.6",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "stats": "node script/generateStats.mjs",
    "fun-stats": "node script/generateFunStats.mjs",
    "rl-leaderboard": "node script/generateRlLeaderboard.mjs",
    "stats-all": "node script/generateStats.mjs && node script/generateFunStats.mjs && node script/generateRlLeaderboard.mjs",
    "version": "node script/bump-version.mjs",
    "sync-version": "node script/bump-version.mjs",
    "check-version": "node script/bump-version.mjs --check",
    "test:rl": "rl/.venv/Scripts/python.exe -m pytest tests/rl -q"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
